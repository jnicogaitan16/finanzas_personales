# === Base de datos (CAMBIAR en produccion) ===
DB_USER=finanzas_user
DB_PASSWORD=GENERA_UNA_PASSWORD_SEGURA_AQUI

# === Evolution API ===
EVOLUTION_API_KEY=GENERA_UNA_API_KEY_AQUI
EVOLUTION_INSTANCE=finanzas

# === Dominio y webhook ===
# Si usas IP sin dominio, Caddy no genera certificado HTTPS.
# Opciones:
#   - Dominio gratis: usar duckdns.org o nip.io
#   - Con dominio: tu-dominio.com
DOMAIN=finanzas.ejemplo.com
WEBHOOK_BASE_URL=https://finanzas.ejemplo.com

# === Admin panel ===
ADMIN_USER=admin
# Generar hash: python -c "from admin.auth import hash_password; print(hash_password('TU_PASSWORD'))"
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=GENERA_CON_pyotp.random_base32()
ADMIN_SESSION_HOURS=24

# === Groq API (transcripcion + parser LLM) ===
GROQ_API_KEY=gsk_TU_KEY_AQUI

# === Usuarios autorizados (numeros WhatsApp) ===
AUTHORIZED_USERS=573001112233,573004445566
