DATABASE_URL=postgresql+psycopg://evolution:evolution@localhost:5433/finanzas

# Usuarios autorizados: Nombre:numero,Nombre:numero (sin + ni espacios)
# AUTHORIZED_USERS=Nico:573001112233,Pareja:573004445566

# Evolution API (Docker Compose inyecta la URL interna)
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=finanzas

# Panel admin en http://localhost:8000/admin
ADMIN_USER=admin
ADMIN_PASSWORD=
# 2FA: genera el secret en /admin/totp-setup y pegalo aquí
ADMIN_TOTP_SECRET=

# Whisper gratis vía Groq (https://console.groq.com/keys)
GROQ_API_KEY=

